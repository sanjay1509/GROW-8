{
  // Open with File > Open Workspace from File. The first folder is the git repository
  // root, so Source Control works. Each Python package is also its own root, so the four
  // separate `app` packages (api + 3 services) never collide in Pylance.
  // The interpreter is the editor-only venv from `make venv`; code still runs in Docker.
  "folders": [
    { "name": "GROW-8", "path": "." },
    { "name": "api", "path": "grow8-backend/api" },
    { "name": "shared", "path": "grow8-backend/shared" },
    { "name": "creator_service", "path": "grow8-backend/services/creator_service" },
    { "name": "contributor_service", "path": "grow8-backend/services/contributor_service" },
    { "name": "admin_service", "path": "grow8-backend/services/admin_service" }
  ],
  "settings": {
    // Windows path. On macOS/Linux use ".../grow8-backend/.venv/bin/python" in your user
    // settings, or run "Python: Select Interpreter" and pick grow8-backend/.venv.
    "python.defaultInterpreterPath": "${workspaceFolder:GROW-8}/grow8-backend/.venv/Scripts/python.exe",

    // The package folders are shown as their own roots; hide the duplicates under the
    // GROW-8 root (patterns are relative to each root, so the other roots are unaffected).
    "files.exclude": {
      "grow8-backend/api": true,
      "grow8-backend/shared": true,
      "grow8-backend/services": true
    },
    "python.analysis.exclude": [
      "grow8-backend/api",
      "grow8-backend/shared",
      "grow8-backend/services",
      "grow8-backend/.venv"
    ],
    "python.analysis.typeCheckingMode": "basic",

    // Use the venv's pinned ruff (same version as the containers) and each
    // package's pyproject.toml settings.
    "ruff.importStrategy": "fromEnvironment",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports.ruff": "explicit"
      }
    },

    // Tests need MySQL/RabbitMQ and run inside Docker: use `make test`.
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": false
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff"
    ]
  }
}
