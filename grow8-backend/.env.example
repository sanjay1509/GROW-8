# Copy to .env (`make env`) and adjust. Never commit .env.
# Inside Docker the hosts are `mysql` and `rabbitmq`, never `localhost`.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=grow8
MYSQL_USER=grow8
MYSQL_PASSWORD=change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Host port for connecting from your machine (e.g. MySQL Workbench)
MYSQL_HOST_PORT=3307

# --- RabbitMQ ---
RABBITMQ_USER=grow8
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=grow8.events
# Host ports for AMQP and the management UI
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# --- API ---
API_HOST_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Secret used to sign JWT access tokens. Leave empty in local dev to use the
# built-in dev-only secret; a real deployment (APP_ENV=production) must set it.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
