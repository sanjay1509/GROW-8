                {
                  "key": "skill",
                  "value": "customer-service"
                },
                {
                  "key": "sort",
                  "value": "deadline"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"filtered and sorted by deadline\", () => {",
                  "  const items = pm.response.json().items;",
                  "  pm.expect(items.length).to.be.above(0);",
                  "  items.forEach(o => {",
                  "    pm.expect(o.category.code).to.eql(\"community\");",
                  "    pm.expect(o.skills.map(s => s.code)).to.include(\"customer-service\");",
                  "  });",
                  "  const deadlines = items.map(o => o.application_deadline);",
                  "  pm.expect(deadlines).to.eql([...deadlines].sort());",
                  "});"
                ]
              }
            }
          ]
        },
